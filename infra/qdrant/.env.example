# Copy to /opt/flowzapp-qdrant/.env on the droplet. Never commit the real file.
QDRANT_HOSTNAME=qdrant.staging.example.com
QDRANT_API_KEY=generate-with-openssl-rand-hex-32
# Nightly snapshots go to this Spaces bucket (backup.sh).
SPACES_BUCKET=flowzapp-staging-backups
SPACES_REGION=nyc3
SPACES_KEY=
SPACES_SECRET=
QDRANT_COLLECTION=flowzapp-staging
