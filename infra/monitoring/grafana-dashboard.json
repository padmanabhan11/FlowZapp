{
  "title": "FlowZapp \u2014 pipeline, index and assistant",
  "uid": "flowzapp-ops",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pipeline success rate by stage",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_pipeline_success_rate",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage duration p95",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_pipeline_duration_ms{quantile=\"0.95\"}",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cost per generated SOP (USD)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_generation_cost_per_sop_usd",
          "legendFormat": "per SOP",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Generation outcomes",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_generation_sops",
          "legendFormat": "succeeded",
          "refId": "A"
        },
        {
          "expr": "flowzapp_generation_failed",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "expr": "flowzapp_generation_halted",
          "legendFormat": "halted (unusable recording)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Embedding backlog",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_index_unindexed_documents",
          "legendFormat": "unindexed documents",
          "refId": "A"
        },
        {
          "expr": "flowzapp_index_failed_jobs",
          "legendFormat": "failed index jobs",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest unindexed (minutes)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_index_oldest_unindexed_minutes",
          "legendFormat": "minutes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        }
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Assistant refusal rate",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_chat_refusal_rate",
          "legendFormat": "refused / answers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Assistant latency p95",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flowzapp_chat_latency_ms{quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "tags": [
    "flowzapp"
  ]
}